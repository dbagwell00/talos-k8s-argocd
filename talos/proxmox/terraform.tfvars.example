# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (holds secrets).
# Create the API token in Proxmox: Datacenter → Permissions → API Tokens.

proxmox_api_url          = "https://proxmox.example.com:8006/api2/json"
proxmox_api_token_id     = "root@pam!terraform"
proxmox_api_token_secret = "00000000-0000-0000-0000-000000000000"

# Optional — defaults live in variables.tf:
# proxmox_nodes     = ["prox01", "prox02", "prox03", "prox04"]
# talos_version     = "v1.8.3"
# cluster_name      = "talos-cilium"
# vm_storage        = "local-lvm"   # node-local NVMe; keep etcd off Ceph
# vm_cores          = 8
# vm_memory_mb      = [16384, 16384, 16384, 24000]   # per node, in proxmox_nodes order
# mesh_vm_cores     = 6
# k8s_external_vlan = 3
# k8s_internal_vlan = 2
